{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/\\.assetsignore$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.js"
    }
  ]
}
